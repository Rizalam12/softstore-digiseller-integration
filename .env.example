# Server
PORT=3000
BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

# SoftStore
SOFTSTORE_API_KEY=YOUR_SOFTSTORE_API_KEY
SOFTSTORE_API_BASE=https://api.softstore.app/api/v1

# Comma-separated trusted SoftStore delivery hostname(s).
# Keep DELIVERY_MODE=disabled until this is verified.
SOFTSTORE_ALLOWED_DELIVERY_HOSTS=YOUR_SOFTSTORE_DELIVERY_HOST

# Digiseller
DIGISELLER_SELLER_ID=YOUR_DIGISELLER_SELLER_ID
DIGISELLER_API_KEY=YOUR_DIGISELLER_API_KEY
DIGISELLER_API_BASE=https://api.digiseller.com/api

# Catalog sync
SOFTSTORE_DEFAULT_CATEGORY_ID=YOUR_SOFTSTORE_CATEGORY_ID
PRICE_MULTIPLIER=1

# Admin protection
ADMIN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Delivery
# Keep disabled until real inventory + durable order locking exist.
DELIVERY_MODE=disabled
STATIC_DELIVERY_TEXT=TEST_DELIVERY_ONLY

# Telegram notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Resend email notifications
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=orders@YOUR_VERIFIED_DOMAIN
NOTIFICATION_EMAIL=YOUR_NOTIFICATION_EMAIL

# Optional / currently unused
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_API_KEY
