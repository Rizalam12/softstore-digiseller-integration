# Server
PORT=3000
BASE_URL=https://YOUR-DOMAIN.example.com

# SoftStore seller API key (keep secret)
SOFTSTORE_API_KEY=
SOFTSTORE_API_BASE=https://api.softstore.app/api/v1

# Digiseller
DIGISELLER_SELLER_ID=
DIGISELLER_API_KEY=
DIGISELLER_API_BASE=https://api.digiseller.com/api

# SoftStore catalog sync
SOFTSTORE_DEFAULT_CATEGORY_ID=1
PRICE_MULTIPLIER=1

# Optional: protect admin/sync routes with a separate secret.
ADMIN_SECRET=

# Delivery
DELIVERY_MODE=disabled
STATIC_DELIVERY_TEXT=TEST DELIVERY - replace this only for testing

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail notifications
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=

# Optional AI gateway integration
AI_GATEWAY_API_KEY=
